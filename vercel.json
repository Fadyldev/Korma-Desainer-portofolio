{
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ais-pre-zb4iqoahferefi4wgus2eo-868251577968.asia-southeast1.run.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://ais-pre-zb4iqoahferefi4wgus2eo-868251577968.asia-southeast1.run.app/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads).*)",
      "destination": "/index.html"
    }
  ]
}
